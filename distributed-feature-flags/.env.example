# Application Settings
APP_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL) Config
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=feature_flags
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Connection String
# For sync drivers (Alembic): postgresql://<user>:<password>@<host>:<port>/<db>
# For async drivers (FastAPI Application): postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_password@localhost:5432/feature_flags

# JWT Secret
JWT_SECRET=super_secret_jwt_signing_key_change_me_in_production
