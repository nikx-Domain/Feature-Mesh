# Application Settings
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
JWT_PRIVATE_KEY="<insert_your_rsa_private_key>"
JWT_PUBLIC_KEY="<insert_your_rsa_public_key>"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<insert_secure_postgres_password>
POSTGRES_DB=feature_flags
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Grafana Settings
GRAFANA_PASSWORD=<insert_secure_grafana_password>

# Redis Settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# Kafka Settings
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
